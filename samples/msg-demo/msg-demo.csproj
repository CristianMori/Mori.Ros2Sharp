<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>msg-demo</AssemblyName>
    <RootNamespace>MsgDemo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mori.Ros2Sharp\Mori.Ros2Sharp.csproj" />
    <!-- The source generator, exactly as a package consumer would get it. -->
    <ProjectReference Include="..\..\src\Mori.Ros2Sharp.Generators\Mori.Ros2Sharp.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="msgs\**\*.msg;msgs\**\*.srv" />
    <CompilerVisibleProperty Include="Ros2SharpNamespace" />
  </ItemGroup>

</Project>
