<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mori.Ros2Sharp.MsgGen</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ros2msggen</ToolCommandName>
    <PackageId>Mori.Ros2Sharp.MsgGen</PackageId>
    <Version>0.6.0</Version>
    <PackageProjectUrl>https://github.com/CristianMori/Mori.Ros2Sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CristianMori/Mori.Ros2Sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Cristian Mori</Authors>
    <Copyright>© 2026 Cristian Mori</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>ros2msggen: generates typed C# message, service, and action classes (CDR serialization) from ROS 2 .msg, .srv, and .action files, for use with Mori.Ros2Sharp.</Description>
    <PackageTags>ros;ros2;dds;rtps;cdr;codegen;robotics</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Compile Include="..\..\shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
