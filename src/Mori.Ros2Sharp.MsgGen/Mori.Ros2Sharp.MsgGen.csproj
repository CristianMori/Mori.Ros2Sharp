<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mori.Ros2Sharp.MsgGen</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ros2msggen</ToolCommandName>
    <PackageId>Mori.Ros2Sharp.MsgGen</PackageId>
    <Version>0.1.0</Version>
    <Authors>Cristian Mori</Authors>
    <Copyright>© 2026 Cristian Mori</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>ros2msggen: generates typed C# message classes (CDR serialization) from ROS 2 .msg files, for use with Mori.Ros2Sharp.</Description>
    <PackageTags>ros;ros2;dds;rtps;cdr;codegen;robotics</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Compile Include="..\..\shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
